{
  "name": "merchant-portal",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "api": "node mock-api/server.mjs",
    "start": "concurrently -k -n api,web -c green,blue \"npm:api\" \"ng serve\"",
    "start:web": "ng serve",
    "build": "ng build",
    "preview:csp": "ng build && SERVE_DIST=1 node mock-api/server.mjs",
    "test": "ng test --watch=false",
    "test:watch": "ng test"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@fontsource-variable/public-sans": "^5.2.5",
    "bootstrap": "^5.3.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.29",
    "@angular/cli": "^21.2.29",
    "@angular/compiler-cli": "^21.2.0",
    "concurrently": "^9.1.2",
    "express": "^4.21.2",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
